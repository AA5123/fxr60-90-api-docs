                  "security": {
                    "installedCertificateName": "FXR60-LAB-AWS-CLIENT",
                    "installedCertificateType": "client",
                    "keyAlgorithm": "RS256",
                    "keyFormat": "PEM",
                    "verifyHostName": true,
                    "verifyPeer": true
